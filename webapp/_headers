# Cloudflare Pages response headers (8 Oct 2026).
#
# Before this file every asset was served "max-age=0, must-revalidate", so each
# page view re-asked for api.js, auth.js, app.css and the logo: ~6 round trips
# of ~500 ms each, measured, before the page's own script could start.
#
# js/ and css/ are referenced as ?v=<content hash> (deploy-webapp.yml stamps
# it), so a changed file is a NEW URL and can never be served stale. They are
# NOT marked immutable for a year on purpose: a manual `wrangler pages deploy`
# skips the stamping, and a year-long cache would then be the stale-api.js
# ("Couldn't book") bug for a year. One hour fresh, then served instantly
# while it revalidates in the background, bounds that case to a single load.
#
# HTML, sw.js and config.js keep the default (always revalidate): they are the
# files that decide which versions everything else loads.

/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800

/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/logo*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/manifest.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Browser security headers, every page (8 Oct 2026).
#   X-Frame-Options / frame-ancestors: nobody can frame the site and trick a
#     tap onto "Book" or "Delete account" (clickjacking).
#   nosniff: a file is only ever run as the type we serve it as.
#   Referrer-Policy: other sites see our origin, never a page's query string.
#   Permissions-Policy: the app uses none of these; say so.
#   Content-Security-Policy: which scripts may run (23 Oct 2026). GENERATED by
#     tools/csp.py - inline page scripts are allowed by hash, and the deploy
#     re-runs the tool, so never edit that line by hand.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-0XlPo9chPvIQtINz3rn30bw2JBsML9U/BZIfrDtnbiA=' 'sha256-9fZGhrAhPKCuKN4B7pN3zY1Wc9pbPiTtweVXfkWj4nc=' 'sha256-NOGSjkUsb0e4ETBCG3ZVHDKlbdIjIyi+wFyta/MGVb4=' 'sha256-UGkbH/KKoeq+ljsbzJ9Hrf20bo5dXu3PNApEu4sbi0c=' 'sha256-Y7SBe2nvcZ6qL8/okqIIvh9H0V2kbOoxI24hsGfs15E=' 'sha256-Z69mOF13MI3PZeHtGXx4YKA+kz+SsHTMtqwoeKJ0xME=' 'sha256-kBhr/HqifDv3R6xXAWCX72PsrtiK3jKwpcprbGOgJRY=' 'sha256-nYkVjJ0zMXi97l5PiIF/TP5ReWBuq2RiAsiRpYd4FnU=' 'sha256-xDkLkZdnY/skZxJXlE7WbB8FNYHzei/gtOzu/QbV4gM=' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://potentialpro-api.onrender.com https://*.supabase.co wss://*.supabase.co https://cloudflareinsights.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
