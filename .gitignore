# Secrets — never commit
.env
.env.local

# Python
venv/
__pycache__/
*.pyc

# Data & artifacts
# data/historical IS tracked (21 MB of football-data.co.uk CSVs) — it is the
# model's training input, so a fresh clone can run models/train.py unaided.
data/raw/
data/*.log
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm
models/*.joblib
*.log

# Machine-local Claude Code state (paths differ per machine)
.claude/settings.local.json

# OS / editor noise
Thumbs.db
.DS_Store

# Worker deps (wrangler installs locally)
worker/node_modules/
worker/.wrangler/

# wrangler build artefacts (Pages/Worker deploys)
.wrangler/
