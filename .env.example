# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Analysis layer (explanation only — never the predictor)
# auto = Gemini if GEMINI_API_KEY is set, else Groq if GROQ_API_KEY is set,
# else local Ollama. Whichever is chosen, it also FAILS OVER at call time:
# Gemini -> Groq -> Ollama, so an outage degrades instead of stopping.
AI_PROVIDER=auto

# Gemini — free tier, no card. Key: https://aistudio.google.com/apikey
# Confirm the model name your key can reach:
#   python analysis/gemma_analyst.py --list-models
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
# Thinking models (3.x flash/pro) need ~2000; *-lite models need 800
GEMINI_MAX_TOKENS=800
# Seconds between calls — free tier is per-minute rate limited
GEMINI_MIN_INTERVAL=4.5

# Ollama (local fallback; needs the model pulled and `ollama serve` running)
# Groq — the CLOUD fallback. Ollama only exists on a laptop, so it cannot help
# the pipeline, which runs in GitHub Actions. Groq serves OPEN-WEIGHT models
# (Llama etc.) on a free tier behind an OpenAI-compatible API, so if it ever
# disappears the same code points elsewhere by changing GROQ_BASE.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OLLAMA_MODEL=gemma3:4b
OLLAMA_HOST=http://localhost:11434

# Database
DB_PATH=./db/sports_predictor.db

# football-data.org (free tier) — https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=your-football-data-token-here

# API-Football (free tier: 100 req/day) — Cloudflare-immune fixtures WITH odds.
# Exists because Forebet is IP-blocked from datacenter hosts. Free key:
# https://dashboard.api-football.com/register
APIFOOTBALL_KEY=your-api-football-key-here
# Free plan rejects page > 3, so a date sweep tops out at ~30 fixtures/day
APIFOOTBALL_MAX_ODDS_PAGES=3
APIFOOTBALL_MAX_REQUESTS=60
